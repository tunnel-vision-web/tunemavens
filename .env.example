# Leave blank in dev when running Vite and the API behind the same nginx
# (Phase 1 config in backend/README.md). Set to the absolute backend URL
# when developing the SPA in isolation.
#
# Examples:
#   VITE_API_BASE_URL=http://localhost:8001
#   VITE_API_BASE_URL=https://api.tunemavens.com
VITE_API_BASE_URL=

# --- Transactional email (Resend) ---
# Without RESEND_API_KEY no email is sent; messages are saved to the email_outbox collection instead.
RESEND_API_KEY=
RESEND_FROM=TuneMavens <hello@tunemavens.com>
PUBLIC_APP_URL=https://tunemavens.com
SETUP_TOKEN_HOURS=72
WHATSAPP_VERIFY_TOKEN=tunemavens_whatsapp_verify_token_2026

# --- Cloud Object Storage (Cloudflare R2 or AWS S3) ---
# When AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are set, all uploaded audio masters,
# DJ mixes, and artwork are persisted directly to S3/R2 instead of ephemeral local disk.
# Cloudflare R2 example endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=tunemaven-assets
# Optional public CDN/custom domain prefix (e.g. https://media.tunemavens.com)
S3_PUBLIC_URL_PREFIX=
