# Leave blank in dev when running Vite and the API behind the same nginx
# (Phase 1 config in backend/README.md). Set to the absolute backend URL
# when developing the SPA in isolation.
#
# Examples:
#   VITE_API_BASE_URL=http://localhost:8001
#   VITE_API_BASE_URL=https://api.tunemavens.com
VITE_API_BASE_URL=

# --- Transactional email (Resend) ---
# Without RESEND_API_KEY no email is sent; messages are saved to the email_outbox collection instead.
RESEND_API_KEY=
RESEND_FROM=TuneMavens <hello@tunemavens.com>
PUBLIC_APP_URL=https://tunemavens.com
SETUP_TOKEN_HOURS=72
WHATSAPP_VERIFY_TOKEN=tunemavens_whatsapp_verify_token_2026
