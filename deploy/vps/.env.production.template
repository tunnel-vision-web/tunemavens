# Copy to deploy/vps/.env.production on your VPS server and fill in live secrets.
# NEVER commit .env.production to Git.

ENV=production
HOST=0.0.0.0
PORT=8001

# MongoDB (defaults to local docker mongo service if using docker-compose.prod.yml)
MONGO_URL=mongodb://mongo:27017
DB_NAME=intermaven_prod

# Path to Intermaven static build/site on the VPS (defaults to ../../apps/portal/dist if omitted)
INTERMAVEN_DIST_PATH=/opt/intermaven

# Security & Auth
JWT_SECRET=CHANGE_ME_TO_A_64_CHAR_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Email Delivery (TuneMavens / Intermaven Communication Protocol)
RESEND_API_KEY=re_CHANGE_ME
SMTP_FROM_EMAIL=hello@tunemavens.com

# Payments (Stripe & M-Pesa)
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
MPESA_ENV=production
MPESA_CONSUMER_KEY=CHANGE_ME
MPESA_CONSUMER_SECRET=CHANGE_ME
MPESA_SHORTCODE=CHANGE_ME
MPESA_PASSKEY=CHANGE_ME
MPESA_CALLBACK_URL=https://tunemavens.com/api/payments/mpesa/callback
