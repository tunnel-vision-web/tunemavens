# Intermaven Network Production Environment Variables Template
# Copy this file to .env on the production VPS server and fill in live secrets

ENV=production
PORT=8001
HOST=127.0.0.1

# 1. MongoDB Atlas Production Cluster
MONGO_URL=mongodb+srv://<prod_db_user>:<prod_db_pass>@cluster0.intermaven.mongodb.net/?retryWrites=true&w=majority
DB_NAME=intermaven_prod

# 2. JWT & SSO Secret Keys
JWT_SECRET=super_secret_production_jwt_key_intermaven_2026_x89q
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 Days

# 3. Stripe Production Credentials
STRIPE_SECRET_KEY=sk_live_51...
STRIPE_PUBLISHABLE_KEY=pk_live_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# 4. AWS S3 / Cloudflare R2 Audio Vault Storage
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET_NAME=intermaven-media-vault
AWS_REGION=us-east-1

# 5. CRM Growth Engine & Resend Email Delivery
RESEND_API_KEY=re_...
SMTP_FROM_EMAIL=support@intermaven.io

# 6. YouTube Data API v3 Key
YOUTUBE_API_KEY=AIzaSy...

# 7. Sentry Production Error Tracking DSN
SENTRY_DSN=https://...ingest.sentry.io/...
