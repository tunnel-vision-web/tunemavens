# Intermaven Network Production Environment Variables Template
# Copy this file to .env on the production VPS server and fill in live secrets

ENV=production
PORT=8001
HOST=127.0.0.1

# 1. MongoDB Atlas Production Cluster
# Option A (Recommended on Render to avoid UI paste-truncation): split MONGO_* variables
MONGO_USER=<prod_db_user>
MONGO_PASSWORD=<prod_db_pass>
MONGO_HOST=cluster0.intermaven.mongodb.net
MONGO_SCHEME=mongodb+srv
MONGO_OPTIONS=retryWrites=true&w=majority
# Option B: single connection string (used if MONGO_USER/MONGO_PASSWORD/MONGO_HOST are not all set)
# MONGO_URL=mongodb+srv://<prod_db_user>:<prod_db_pass>@cluster0.intermaven.mongodb.net/?retryWrites=true&w=majority
DB_NAME=intermaven_prod

# 1b. CORS Allowed Origins (comma-separated, merged with built-in production domains)
CORS_ORIGINS=https://tunemavens.com,https://www.tunemavens.com,https://tunestream.co,https://www.tunestream.co,https://syncmavens.com,https://www.syncmavens.com,https://intermaven.io,https://www.intermaven.io

# 2. JWT & SSO Secret Keys
JWT_SECRET=super_secret_production_jwt_key_intermaven_2026_x89q
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 Days

# 3. Stripe Production Credentials
STRIPE_SECRET_KEY=sk_live_51...
STRIPE_PUBLISHABLE_KEY=pk_live_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# 4. AWS S3 / Cloudflare R2 Audio Vault Storage
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET_NAME=intermaven-media-vault
AWS_REGION=us-east-1

# 5. CRM Growth Engine & Resend Email Delivery
RESEND_API_KEY=re_...
SMTP_FROM_EMAIL=support@intermaven.io

# 6. YouTube Data API v3 Key
YOUTUBE_API_KEY=AIzaSy...

# 7. Sentry Production Error Tracking DSN
SENTRY_DSN=https://...ingest.sentry.io/...

# 8. Safaricom Daraja M-Pesa STK Push Credentials
MPESA_ENV=production
MPESA_CONSUMER_KEY=...
MPESA_CONSUMER_SECRET=...
MPESA_SHORTCODE=...
MPESA_PASSKEY=...
MPESA_CALLBACK_URL=https://api.tunemavens.com/api/payments/mpesa/callback
